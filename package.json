{
  "name": "snapline-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run test && npm run build",
    "preview": "node scripts/serve.mjs",
