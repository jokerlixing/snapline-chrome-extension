    "test:all": "npm test && npm run build && npm run test:engine && npm run test:e2e"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "playwright": "^1.55.0"
  }
}
